# How to attach KAP config to system nginx
#
# 1. In /etc/nginx/nginx.conf find the http { } block and add INSIDE it:
#
#      include /opt/kap/data/nginx-kap.conf;
#
#    (or whatever path the panel writes — see SSL/Nginx → config path)
#
# 2. Do NOT include the file inside a server { } block.
#    "upstream" / "server" directives are only valid in http context.
#
# 3. KAP process must listen on the upstream port (e.g. 127.0.0.1:8443).
#    Panel process on its port (e.g. 127.0.0.1:8080).
#    nginx owns :443 (HTTPS) and optionally :80 redirect.
#
# 4. Test and reload:
#      nginx -t && systemctl reload nginx
#
# Minimal http { } sketch:
#
# http {
#     include       /etc/nginx/mime.types;
#     default_type  application/octet-stream;
#     sendfile      on;
#     keepalive_timeout 65;
#
#     include /opt/kap/data/nginx-kap.conf;
#     include /etc/nginx/conf.d/*.conf;
# }
